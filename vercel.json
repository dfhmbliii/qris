{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": null,
    "installCommand": "npm install",
    "outputDirectory": null,
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api/index"
        }
    ],
    "functions": {
        "api/index.js": {
            "maxDuration": 60,
            "includeFiles": "public/**"
        }
    }
}