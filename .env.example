# Konfigurasi Server
PORT=3000

# Kredensial Login Admin
ADMIN_USER=your_admin_username
ADMIN_PASS=your_admin_password

# Kredensial Supabase
# PENTING: pakai service_role_key HANYA di server (backend/Vercel).
# Jangan pernah memakai anon key di sini karena RLS akan memblokir query.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Kunci Rahasia JWT (WAJIB di-set di production, minimal 32 karakter random)
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# Token Fonnte (Layanan Pengiriman WhatsApp)
FONNTE_TOKEN=your_fonnte_api_token

# Origin yang boleh mengakses API (pisahkan dengan koma).
# Kosongkan = semua origin diizinkan (hanya untuk development).
ALLOWED_ORIGINS=https://domain-anda.vercel.app

# Base URL aplikasi, dipakai untuk link reset password via WhatsApp.
# Kosongkan = otomatis mengikuti host dari request.
APP_BASE_URL=